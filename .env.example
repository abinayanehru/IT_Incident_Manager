# ==============================================================================
# IT Incident Management and Resolution System - Environment Configuration Template
# Copy this file to .env and supply your local environment values.
# NEVER commit the actual .env file with real credentials to version control.
# ==============================================================================

# Backend / Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Host Windows MySQL 8.0 on Port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=incident_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/incident_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT / Security Configuration
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_PORT=5173

# SonarQube Configuration (Docker Compose)
SONAR_PORT=9000
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar_secure_password
SONAR_DB_NAME=sonar
SONAR_DB_PORT=5432
